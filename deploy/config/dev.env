# AI Smart Vending Machine - Development Environment
# Windows PC Testing Configuration

# ============================================
# General Settings
# ============================================
NODE_ENV=development
LOG_LEVEL=DEBUG

# ============================================
# IO Board Service (Mock Mode)
# ============================================
IO_BOARD_PORT=mock
IO_BOARD_MOCK_MODE=true
IO_BOARD_BAUDRATE=38400

# ============================================
# Model Service (CPU Mode)
# ============================================
YOLO_MODEL_PATH=/app/models/siyeon_best.pt
YOLO_CONFIDENCE_THRESHOLD=0.3
USE_CPU=true
CUDA_VISIBLE_DEVICES=

# ============================================
# Camera Settings (Folder Mode)
# ============================================
CAMERA_MODE=folder
SNAPSHOT_FOLDER=/app/data/snapshots
CAMERA_RESOLUTION=640x480

# ============================================
# MQTT Broker (Local)
# ============================================
MQTT_BROKER_HOST=host.docker.internal
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=ai-vending-dev
MQTT_QOS=0

# ============================================
# Service URLs (Docker network)
# ============================================
IO_BOARD_URL=http://io_board:8000
MODEL_URL=http://model:8002
CAMERA_URL=http://camera_driver:8003
CARD_TERMINAL_URL=http://card_terminal:8004
MQTT_CLIENT_URL=http://mqtt_client:8006
NODEJS_URL=http://node_server:8888

# ============================================
# Development Helpers
# ============================================
MOCK_PAYMENT=true
DEBUG_SSE=true
