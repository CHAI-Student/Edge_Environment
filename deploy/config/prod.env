# AI Smart Vending Machine - Production Environment
# Jetson Orin Nano Configuration

# ============================================
# General Settings
# ============================================
NODE_ENV=production
LOG_LEVEL=INFO

# ============================================
# IO Board Service
# ============================================
IO_BOARD_PORT=/dev/ttyTHS0
IO_BOARD_BAUDRATE=38400
IO_BOARD_TIMEOUT=5000

# ============================================
# Model Service
# ============================================
YOLO_MODEL_PATH=/app/models/siyeon_best.pt
YOLO_CONFIDENCE_THRESHOLD=0.5
USE_TENSORRT=true
TENSORRT_FP16=true

# ============================================
# Camera Settings
# ============================================
CAMERA_RESOLUTION=640x480
CAMERA_FPS=30
V4L2_BUFFER_COUNT=4

# ============================================
# MQTT Broker
# ============================================
MQTT_BROKER_HOST=192.168.1.10
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=ai-vending-edge
MQTT_QOS=1

# ============================================
# Service URLs (internal Docker network)
# ============================================
IO_BOARD_URL=http://io_board:8001
MODEL_URL=http://model:8002
CAMERA_URL=http://camera_driver:8003
CARD_TERMINAL_URL=http://card_terminal:8004
MQTT_CLIENT_URL=http://mqtt_client:8006
NODEJS_URL=http://node_server:8888

# ============================================
# Database (if using MongoDB)
# ============================================
# MONGO_URI=mongodb://localhost:27017/ai-vending

# ============================================
# Security (generate secure values!)
# ============================================
# JWT_SECRET=your-secure-jwt-secret-here
# API_KEY=your-secure-api-key-here
