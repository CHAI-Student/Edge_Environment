# Camera Driver Service Dockerfile
# 6-camera management for AI Smart Vending Machine

FROM python:3.11-slim-bookworm

LABEL service="camera_driver"
LABEL version="1.0.0"
LABEL description="6-camera management service for Zone monitoring"

WORKDIR /app

# Install system dependencies for OpenCV and V4L2
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    v4l-utils \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy project files for installation
COPY pyproject.toml ./
RUN mkdir -p ./services
COPY services/__init__.py ./services/
COPY services/camera_driver ./services/camera_driver

# Install Python dependencies
RUN pip install --no-cache-dir .

# Set Python path
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8003/api/health || exit 1

EXPOSE 8003

CMD ["uvicorn", "services.camera_driver.main:app", "--host", "0.0.0.0", "--port", "8003"]
