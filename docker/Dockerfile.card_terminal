# Card Terminal Service Dockerfile
# Payment terminal integration

FROM python:3.11-slim-bookworm

LABEL service="card_terminal"
LABEL version="1.0.0"
LABEL description="Card payment terminal service"

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy project files for installation
COPY pyproject.toml ./
RUN mkdir -p ./services
COPY services/__init__.py ./services/
COPY services/card_terminal ./services/card_terminal

# Install Python dependencies
RUN pip install --no-cache-dir .

# Set Python path
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Health check (REST API port)
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8004/status || exit 1

# REST API port
EXPOSE 8004
# TCP server port
EXPOSE 5000

CMD ["python", "-m", "services.card_terminal.main"]
