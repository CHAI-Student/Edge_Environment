# MQTT Client Service Dockerfile
# CHAI IF01-04 protocol implementation

FROM python:3.11-slim-bookworm

LABEL service="mqtt_client"
LABEL version="1.0.0"
LABEL description="MQTT client for CHAI interface protocols"

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy project files for installation
COPY pyproject.toml ./
RUN mkdir -p ./services
COPY services/__init__.py ./services/
COPY services/mqtt_client ./services/mqtt_client

# Install Python dependencies (base + mqtt)
RUN pip install --no-cache-dir ".[mqtt]"

# Set Python path
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# MQTT broker configuration (override in docker-compose)
ENV MQTT_BROKER_HOST=host.docker.internal
ENV MQTT_BROKER_PORT=1883

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8006/health || exit 1

EXPOSE 8006

CMD ["uvicorn", "services.mqtt_client.main:app", "--host", "0.0.0.0", "--port", "8006"]
