# Node.js Orchestrator Service Dockerfile
# Main coordinator for all Python microservices

FROM node:20-slim

LABEL service="node_server"
LABEL version="1.0.0"
LABEL description="Node.js orchestrator for AI Smart Vending Machine"

WORKDIR /app

# Install curl for health checks
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy package files
COPY package*.json ./

# Install production dependencies only
RUN npm ci --only=production && npm cache clean --force

# Copy server source code
COPY server/ /app/server/

# Set environment
ENV NODE_ENV=production

# Service URLs (override in docker-compose)
ENV IO_BOARD_URL=http://io_board:8001
ENV MODEL_URL=http://model:8002
ENV CAMERA_URL=http://camera_driver:8003

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8888/health || exit 1

EXPOSE 8888

CMD ["node", "server/index.js"]
