{
  "name": "edge_environment",
  "version": "1.0.0",
  "description": "Edge Environment setting for CHAI project - main server(js)",
  "main": "index.js",
  "scripts": {
    "start": "pm2 start ecosystem.config.js",
    "start:prod": "npm run build:client && pm2 start ecosystem.config.js --env production",
    "stop": "pm2 stop all",
    "restart": "pm2 restart all",
    "logs": "pm2 logs",
    "status": "pm2 status",
    "delete": "pm2 delete all",
    "build:client": "npm run build --prefix client",
    "start:server": "node server/index.js",
    "start:server:dev": "nodemon server/index.js",
    "start:frontend": "npm run start --prefix client",
    "dev": "concurrently \"npm run start:server:dev\" \"npm run start:frontend\"",
    "test": "node server/test/MqttReboot.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CHAI-Student/Edge_Environment.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/CHAI-Student/Edge_Environment/issues"
  },
  "homepage": "https://github.com/CHAI-Student/Edge_Environment#readme",
  "dependencies": {
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "eventsource": "^4.1.0",
    "express": "^4.22.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "minio": "^8.0.0",
    "mongoose": "^9.1.3",
    "mqtt": "^5.14.1",
    "multer": "^1.4.5-lts.1",
    "pino": "^10.1.1",
    "pm2": "^6.0.14",
    "serialport": "^13.0.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.11"
  }
}
