    "delete": "pm2 delete all",
    "client": "npm run start --prefix client",
    "services": "pm2 start ecosystem.config.js --only model",
    "services:stop": "pm2 stop model",
    "all": "pm2 start ecosystem.config.js",
    "build:client": "npm run build --prefix client",
    "start:prod": "npm run build:client && pm2 start ecosystem.config.js --env production"
  },
